{
  "name": "stickit",
  "private": true,
  "version": "1.0.6",
  "buildNumber": 44,
  "type": "module",
  "scripts": {
    "dev": "pnpm frontend:dev",
    "frontend:dev": "vite --config apps/frontend/vite.config.ts",
    "frontend:build": "tsc -p apps/frontend/tsconfig.json && vite build --config apps/frontend/vite.config.ts --mode stickit-main && vite build --config apps/frontend/vite.config.ts --mode stickit-floating",
    "frontend:preview": "vite preview --config apps/frontend/vite.config.ts",
    "build": "pnpm frontend:build",
    "macos:build": "pnpm build && xcodebuild -project apps/mac-host/StickIt.xcodeproj -scheme StickIt -configuration Debug -derivedDataPath build/DerivedData CODE_SIGNING_ALLOWED=NO build",
    "macos:test": "xcodebuild test -project apps/mac-host/StickIt.xcodeproj -scheme StickIt -configuration Debug -derivedDataPath build/DerivedData CODE_SIGNING_ALLOWED=NO",
    "macos:run": "./scripts/run-macos-dev.sh",
    "windows:build": "pnpm build && dotnet build apps/windows-host/StickIt.Windows.csproj",
    "windows:run": "pnpm build && dotnet run --project apps/windows-host/StickIt.Windows.csproj",
    "preview": "pnpm frontend:preview",
    "test": "vitest --config apps/frontend/vite.config.ts",
    "test:layout": "playwright test --config apps/frontend/playwright.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "slate": "^0.124.0",
    "slate-history": "^0.113.1",
    "slate-react": "^0.124.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "20.17.30",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^29.0.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.4.5",
    "vite": "^5.4.19",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
